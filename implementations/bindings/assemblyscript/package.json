{
  "scripts": {
    "asbuild:untouched": "asc assembly/index.ts -o build/untouched.wasm -t build/untouched.wat --sourceMap --debug --exportStart _start --runtime stub",
    "asbuild:optimized": "asc assembly/index.ts -o build/optimized.wasm -t build/optimized.wat --sourceMap --exportStart _start --runtime stub --optimize",
    "asbuild": "npm run asbuild:untouched && npm run asbuild:optimized",
    "test": "node tests"
  },
  "dependencies": {
    "@assemblyscript/loader": "^0.28"
  },
  "devDependencies": {
    "as-wasi": "^0.6",
    "assemblyscript": "^0.28"
  }
}
